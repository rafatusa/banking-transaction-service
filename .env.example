# Local development configuration.
# Copy to .env and fill in the blanks — .env is gitignored and must never be committed.
# In deployed environments every one of these arrives from CI secrets via Puppet.
#
# Generate the two credential values with:
#   openssl rand -hex 32

# ---- Database ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking
DB_USERNAME=banking
# Must match what you passed to the local postgres container.
DB_PASSWORD=

# ---- Security ----------------------------------------------------------------
# Must be at least 32 characters: the application refuses to start otherwise,
# because HS256 requires 256 bits of key material.
JWT_SECRET=
JWT_VALIDITY_MINUTES=60

# ---- Bootstrap admin ---------------------------------------------------------
# Seeded at startup only if the user does not already exist. Leave both blank
# to skip seeding entirely.
APP_SEED_ADMIN_USERNAME=admin
APP_SEED_ADMIN_PASSWORD=

# ---- Server ------------------------------------------------------------------
SERVER_PORT=8080
