<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.12</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>banking-transaction-service</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>banking-transaction-service</name>
  <description>Enterprise Banking Transaction Service</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      SECURITY PINS — override the parent BOM's managed versions.

      The container scan (trivy_image) failed the release on six CRITICAL/HIGH
      CVEs, every one of them in a dependency whose version is chosen by the
      Spring Boot parent rather than declared here:

        tomcat-embed-core 10.1.31  CVE-2025-24813 (CRITICAL), CVE-2026-41293 (CRITICAL)
        jackson-databind  2.15.4   CVE-2026-54512 (HIGH), CVE-2026-54513 (HIGH)
        jackson-core      2.15.4   GHSA-r7wm-3cxj-wff9 (HIGH)
        micrometer-core   1.12.11  CVE-2026-40984 (HIGH)

      Spring Boot 3.2 is end of life, so its final release (3.2.12, confirmed as
      the last v3.2.x tag in the upstream repository) does not carry these
      fixes. The parent is moved to 3.2.12 regardless — it is strictly newer at
      no compatibility cost — and the four artifacts are then pinned FORWARD to
      the exact fixed versions the advisories name.

      Pinning individual artifacts rather than jumping to a supported minor
      (3.5.x) is deliberate: within a patch line these are drop-in replacements,
      whereas 3.2 -> 3.5 changes behaviour across Spring Security, Spring Data
      JPA and Actuator and would need its own migration and test pass. Upgrading
      to a supported Spring Boot line remains the RIGHT long-term fix and is
      tracked as an explicit follow-up — these pins keep the shipped artifact
      free of known CRITICAL/HIGH CVEs in the meantime, they do not make 3.2
      supported again.

      Jackson is pinned via jackson-bom so that every jackson module
      (core, databind, annotations, datatype-*) moves together — pinning
      databind alone against an older core is how NoSuchMethodError at runtime
      happens.

      Each version below is the fixed version reported by the scanner itself,
      chosen as the lowest release that closes every listed advisory.
    -->
    <tomcat.version>10.1.35</tomcat.version>
    <jackson-bom.version>2.18.8</jackson-bom.version>
    <micrometer.version>1.15.12</micrometer.version>

    <jjwt.version>0.12.6</jjwt.version>
    <springdoc.version>2.3.0</springdoc.version>
    <testcontainers.version>1.19.8</testcontainers.version>
    <rest-assured.version>5.4.0</rest-assured.version>

    <spotless.version>2.43.0</spotless.version>
    <checkstyle.plugin.version>3.3.1</checkstyle.plugin.version>
    <checkstyle.version>10.14.2</checkstyle.version>
    <!--
      maven-pmd-plugin 3.26.0 bundles PMD 7.x. Earlier 3.2x releases bundle
      PMD 6.55.0, which predates Java 21 and rejects targetJdk=21 outright
      ("Unsupported targetJdk value '21'"), failing the gate before it inspects
      any code.
    -->
    <pmd.plugin.version>3.26.0</pmd.plugin.version>
    <spotbugs.plugin.version>4.8.3.1</spotbugs.plugin.version>
    <jacoco.version>0.8.11</jacoco.version>
    <pitest.version>1.15.8</pitest.version>
    <pitest.junit5.version>1.2.1</pitest.junit5.version>
    <cyclonedx.version>2.7.11</cyclonedx.version>
    <failsafe.version>3.2.5</failsafe.version>

    <!--
      Coverage gates: line >= 90%, branch >= 85%, enforced in the dedicated
      `coverage` pipeline stage over the MERGED unit + integration execution
      data. The controllers and the exception handler are exercised by the
      REST Assured suite against a real Postgres, so unit-only measurement
      understates real coverage by roughly half.
    -->
    <jacoco.line.min>0.90</jacoco.line.min>
    <jacoco.branch.min>0.85</jacoco.branch.min>
    <!-- Mutation score gate >= 70% (enforced in the mutation_tests stage) -->
    <pitest.mutation.threshold>70</pitest.mutation.threshold>
    <!-- PMD violation threshold: zero tolerance for priority 1-3 findings -->
    <pmd.max.violations>0</pmd.max.violations>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Jackson: import the whole BOM so every jackson artifact resolves to the
        same fixed version. `jackson-bom.version` above is honoured by Spring
        Boot's own BOM too, but importing explicitly keeps the guarantee even if
        the parent changes how it manages Jackson.
      -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Micrometer: BOM import keeps core and the prometheus registry aligned. -->
      <dependency>
        <groupId>io.micrometer</groupId>
        <artifactId>micrometer-bom</artifactId>
        <version>${micrometer.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web / API -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Security -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Persistence -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Observability -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- OpenAPI / Swagger UI -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${rest-assured.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Spotless: source hygiene gate.

        Enforces the rules that catch real problems — dead imports, trailing
        whitespace, missing final newlines — without imposing a whole-file layout
        formatter or an import ORDER on the existing source.

        Adding a layout formatter (googleJavaFormat / palantir) is worthwhile but
        is a repository-wide reformat — see the README's "Code style" section for
        the one-commit procedure.
      -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>

      <!-- Checkstyle: fails on ANY violation -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle.plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>${checkstyle.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>config/checkstyle/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <violationSeverity>warning</violationSeverity>
          <failOnViolation>true</failOnViolation>
          <includeTestSourceDirectory>false</includeTestSourceDirectory>
          <outputFile>${project.build.directory}/checkstyle-result.xml</outputFile>
        </configuration>
      </plugin>

      <!-- PMD + CPD (PMD 7 via plugin 3.26.0 — required for Java 21 support) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>${pmd.plugin.version}</version>
        <configuration>
          <rulesets>
            <ruleset>config/pmd/ruleset.xml</ruleset>
          </rulesets>
          <failOnViolation>true</failOnViolation>
          <printFailingErrors>true</printFailingErrors>
          <maxAllowedViolations>${pmd.max.violations}</maxAllowedViolations>
          <minimumPriority>3</minimumPriority>
          <includeTests>false</includeTests>
          <targetJdk>${java.version}</targetJdk>
          <minimumTokens>80</minimumTokens>
          <format>xml</format>
        </configuration>
      </plugin>

      <!-- SpotBugs: fails on High priority findings -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>${spotbugs.plugin.version}</version>
        <configuration>
          <effort>Max</effort>
          <threshold>High</threshold>
          <failOnError>true</failOnError>
          <includeTests>false</includeTests>
          <xmlOutput>true</xmlOutput>
          <spotbugsXmlOutputDirectory>${project.build.directory}</spotbugsXmlOutputDirectory>
        </configuration>
      </plugin>

      <!--
        JaCoCo — merged unit + integration coverage.

        Surefire (unit) and Failsafe (integration) run in SEPARATE JVMs, and in
        the pipeline they run in separate JOBS. Each writes its own execution
        file:
            target/jacoco-ut.exec   <- prepare-agent      (surefire)
            target/jacoco-it.exec   <- prepare-agent-integration (failsafe)

        The `merge` execution combines every target/*.exec into
        target/jacoco-merged.exec, and BOTH the report and the 90/85 gate read
        only that merged file. The `coverage` pipeline stage downloads both
        stages' exec artifacts into target/ before invoking merge.

        Consequence: `mvn test` alone can no longer satisfy the gate, which is
        correct — the gate is a statement about the whole test suite.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <exclude>**/BankingTransactionServiceApplication.class</exclude>
            <exclude>**/config/**</exclude>
            <exclude>**/dto/**</exclude>
            <exclude>**/entity/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- Unit-test agent -> target/jacoco-ut.exec -->
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco-ut.exec</destFile>
            </configuration>
          </execution>

          <!-- Integration-test agent -> target/jacoco-it.exec -->
          <execution>
            <id>prepare-agent-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco-it.exec</destFile>
            </configuration>
          </execution>

          <!-- Merge every *.exec present into one data set -->
          <execution>
            <id>merge-coverage</id>
            <goals>
              <goal>merge</goal>
            </goals>
            <configuration>
              <fileSets>
                <fileSet>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>*.exec</include>
                  </includes>
                  <excludes>
                    <exclude>jacoco-merged.exec</exclude>
                  </excludes>
                </fileSet>
              </fileSets>
              <destFile>${project.build.directory}/jacoco-merged.exec</destFile>
            </configuration>
          </execution>

          <!-- HTML/XML report from the merged data -->
          <execution>
            <id>merged-report</id>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
              <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
            </configuration>
          </execution>

          <!-- The 90/85 gate, over the merged data -->
          <execution>
            <id>coverage-gate</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-merged.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.min}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.branch.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- PIT mutation testing: score >= 70% -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>com.example.bankingtransactionservice.service.*</param>
            <param>com.example.bankingtransactionservice.security.*</param>
            <param>com.example.bankingtransactionservice.web.*</param>
          </targetClasses>
          <targetTests>
            <param>com.example.bankingtransactionservice.*Test</param>
          </targetTests>
          <mutationThreshold>${pitest.mutation.threshold}</mutationThreshold>
          <outputFormats>
            <outputFormat>HTML</outputFormat>
            <outputFormat>XML</outputFormat>
          </outputFormats>
          <timestampedReports>false</timestampedReports>
        </configuration>
      </plugin>

      <!--
        Dependency CVE scanning is performed by TRIVY against the built Spring
        Boot JAR, in the pipeline's `dependency_scan` stage — not by a Maven
        plugin. See docs/adr/0004-trivy-replaces-owasp-dependency-check.md.

        OWASP Dependency-Check 9.x was removed: it must populate a local copy of
        the NVD database over the rate-limited NVD 2.0 API, which fails with a
        MojoExecutionException on shared GitHub-hosted runner IPs unless an
        NVD API key is registered with NIST and supplied as a secret.

        Trivy carries its own vulnerability database, needs no API key, and is
        already used by the filesystem and container scan stages. It reads the
        fat JAR's BOOT-INF/lib/, so it sees every resolved direct AND transitive
        dependency — which `pom.xml` alone does not expose.
      -->

      <!-- CycloneDX SBOM -->
      <plugin>
        <groupId>org.cyclonedx</groupId>
        <artifactId>cyclonedx-maven-plugin</artifactId>
        <version>${cyclonedx.version}</version>
        <configuration>
          <outputFormat>json</outputFormat>
          <outputName>bom</outputName>
          <projectType>application</projectType>
          <schemaVersion>1.5</schemaVersion>
        </configuration>
      </plugin>

      <!-- Failsafe for *IT integration tests -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${failsafe.version}</version>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>integration-tests</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>integration-test</id>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
