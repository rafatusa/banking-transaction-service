<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppression file.

  POLICY: this file starts EMPTY and must stay that way unless a finding is
  demonstrably a false positive for this application. Every suppression must
  record:
    - the CVE being suppressed
    - WHY it does not apply here (not "we'll fix it later")
    - the date it was added and who reviewed it

  Suppressing a real vulnerability to make the pipeline green defeats the
  purpose of the security gate. If a High/Critical CVE is genuine, upgrade the
  dependency instead.

  Example of a correctly justified suppression:

  <suppress until="2026-12-31Z">
    <notes><![CDATA[
      CVE-0000-00000 affects the XML parsing path of this library.
      This application only uses its JSON codec, which is unaffected.
      Reviewed 2026-08-28.
    ]]></notes>
    <packageUrl regex="true">^pkg:maven/com\.example/some-lib@.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
