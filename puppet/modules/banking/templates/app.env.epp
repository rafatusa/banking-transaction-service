<%- |
  String  $db_host,
  Integer $db_port,
  String  $db_name,
  String  $db_username,
  String  $db_password,
  String  $jwt_secret,
  Integer $jwt_validity,
  Integer $app_port,
  String  $seed_username,
  String  $seed_password,
| -%>
# Managed by Puppet. Do not edit by hand — changes are overwritten on deploy.
# Mode 0640, owned by the application user: this file contains credentials.

SERVER_PORT=<%= $app_port %>

DB_HOST=<%= $db_host %>
DB_PORT=<%= $db_port %>
DB_NAME=<%= $db_name %>
DB_USERNAME=<%= $db_username %>
DB_PASSWORD=<%= $db_password %>

JWT_SECRET=<%= $jwt_secret %>
JWT_VALIDITY_MINUTES=<%= $jwt_validity %>

APP_SEED_ADMIN_USERNAME=<%= $seed_username %>
APP_SEED_ADMIN_PASSWORD=<%= $seed_password %>

SPRING_PROFILES_ACTIVE=production
