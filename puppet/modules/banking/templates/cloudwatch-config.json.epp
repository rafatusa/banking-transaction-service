<%- |
  String $app_log_group,
  String $sys_log_group,
  String $region,
| -%>
{
  "agent": {
    "metrics_collection_interval": 60,
    "region": "<%= $region %>",
    "logfile": "/var/log/amazon-cloudwatch-agent.log"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/nginx/banking-access.log",
            "log_group_name": "<%= $sys_log_group %>",
            "log_stream_name": "{instance_id}/nginx-access",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/nginx/banking-error.log",
            "log_group_name": "<%= $sys_log_group %>",
            "log_stream_name": "{instance_id}/nginx-error",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "<%= $sys_log_group %>",
            "log_stream_name": "{instance_id}/syslog",
            "retention_in_days": -1
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "<%= $app_log_group %>",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "resources": [
          "/"
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
